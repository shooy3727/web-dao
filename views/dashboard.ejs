<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quản Lý & Chỉnh Sửa Hồ Sơ | GaiGoi247</title>
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>

  <!-- ================= HEADER ================= -->
  <header class="site-header" id="siteHeader">
    <div class="header-container">
      <div class="header-left">
        <button class="sidebar-toggle" id="sidebarToggle" aria-label="Mở/Đóng Sidebar">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <a href="/" class="brand-logo logo">
          <span class="logo-accent">CINE</span>VANE
        </a>
      </div>

      <div class="header-right">
        <div class="user-profile-badge">
          <div class="avatar-circle">
            <img src="https://media.istockphoto.com/id/950688808/vi/anh/th%C6%B0%E1%BB%9Fng-th%E1%BB%A9c-cocktail-t%E1%BA%A1i-h%E1%BB%93-b%C6%A1i.jpg?s=2048x2048&w=is&k=20&c=7Zw9E10sHoShHGAvAueOQZkXzk8NwAuLTd-bu81knJQ=" alt="Avatar User">
          </div>
          <span class="user-name"><%= typeof user !== 'undefined' ? user.fullname : 'Nguyễn Văn A' %></span>
        </div>
      </div>
    </div>
  </header>

  <!-- ================= DASHBOARD WRAPPER ================= -->
  <div class="dashboard-wrapper">
    
    <!-- ================= SIDEBAR ================= -->
    <aside class="dashboard-sidebar" id="dashboardSidebar">
      <nav class="sidebar-nav">
        <div class="nav-group">
          <span class="nav-label">TỔNG QUAN</span>
          <a href="/dashboard" class="nav-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            <span>Dashboard</span>
          </a>
        </div>

        <div class="nav-group">
          <span class="nav-label">QUẢN LÝ HỒ SƠ</span>
          <a href="/dashboard" class="nav-item <%= page === 'profile' ? 'active-sub' : '' %>">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <span>Hồ sơ của tôi</span>
          </a>
          <a href="/dashboard?edit=1" class="nav-item <%= page === 'create' ? 'active-sub' : '' %>">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            <span>Đăng bài / Tạo hồ sơ</span>
          </a>
        </div>

        <div class="nav-group">
          <span class="nav-label">CÀI ĐẶT</span>
          <a href="/dashboard/account" class="nav-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            <span>Thông tin tài khoản</span>
          </a>
          <a href="/logout" class="nav-item logout-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            <span>Đăng xuất</span>
          </a>
        </div>
      </nav>
    </aside>

    <!-- Overlay cho mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="dashboard-content">

  <% if (page === "profile") { %>

    <%- include("partials/profile") %>

  <% } else if (page === "account") { %>

    <%- include("partials/account") %>

  <% } else { %>

    <%- include("partials/create-profile") %>

  <% } %>

</main>
  </div>

  <!-- Toast Notification -->
  <div id="toast" class="toast-notification" aria-live="polite"></div>

  <!-- JS Dashboard -->
  <script src="/js/config/regions.js"></script>
  <script src="/js/helpers/regionHelper.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/profile-form.js"></script>
  <script src="/js/account.js"></script>
</body>
</html>