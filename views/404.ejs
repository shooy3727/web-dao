<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Không Tìm Thấy Trang | PREMIUM PROFILE</title>
  
  <!-- CSS Cục bộ -->
  <link rel="stylesheet" href="/css/detail.css">
  <link rel="stylesheet" href="/css/404.css">
</head>
<body>

  <!-- ================= HEADER ================= -->
  <header class="site-header" id="siteHeader">
    <div class="container header-container">
      <a href="/" class="brand-logo logo">
        <span>PREMIUM</span>PROFILE
      </a>
      
      <button class="menu-toggle" id="menuToggle" aria-label="Mở menu điều hướng">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <nav class="nav-menu" id="navMenu">
        <a href="/" class="nav-link">Trang chủ</a>
        <a href="/lien-he" class="nav-link">Liên Hệ</a>
      </nav>
    </div>
  </header>

  <!-- ================= BREADCRUMB ================= -->
  <div class="breadcrumb-wrapper">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Trang chủ</a></li>
          <li aria-current="page"><span>Lỗi 404</span></li>
        </ol>
      </nav>
    </div>
  </div>

  <!-- ================= MAIN CONTENT ================= -->
  <main class="main-content">
    <div class="container error-page-wrapper">
      <div class="error-card">
        <div class="glow-sphere glow-1"></div>
        <div class="glow-sphere glow-2"></div>

        <div class="error-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          Trang không tồn tại
        </div>

        <div class="error-code-wrapper">
          <h1 class="error-code">404</h1>
        </div>

        <h2 class="error-title">Rất tiếc, đường dẫn này đã thất lạc!</h2>
        <p class="error-desc">
          Hồ sơ hoặc trang bạn đang tìm kiếm có thể đã bị xóa, thay đổi địa chỉ hoặc tạm thời không khả dụng.
        </p>

        <div class="error-actions">
          <a href="/" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            Về Trang Chủ
          </a>
          <a href="/lien-he" class="btn btn-outline">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            Trợ Giúp / Liên Hệ
          </a>
        </div>
      </div>
    </div>
  </main>

  <!-- ================= FOOTER ================= -->
  <footer class="site-footer">
    <div class="container footer-container">
      <p>&copy; 2027 Premium Profile Network. All rights reserved.</p>
      <div class="footer-links">
        <a href="/lien-he">Liên Hệ</a>
      </div>
    </div>
  </footer>

  <!-- Notification Toast -->
  <div id="toast" class="toast-notification" aria-live="polite"></div>

  <!-- JS Cục bộ (Đảm bảo menu toggle di động hoạt động) -->
  <script src="/js/404.js"></script>
</body>
</html>