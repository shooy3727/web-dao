<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đặt lại mật khẩu - CineVerse</title>
  
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Custom CSS (Tái sử dụng forgot-password.css) -->
  <link rel="stylesheet" href="/css/forgot-password.css">
</head>
<body>
  <!-- Background Decorative Light Orbs -->
  <div class="bg-decorations" aria-hidden="true">
    <div class="glow-orb orb-top-left"></div>
    <div class="glow-orb orb-top-right"></div>
    <div class="glow-orb orb-center"></div>
    <div class="glow-orb orb-bottom-right"></div>
  </div>

  <!-- Navbar Section -->
  <header class="navbar-container">
    <nav class="navbar">
      <a href="/" class="brand-logo" aria-label="CineVerse Trang chủ">
        <span class="logo-cine">Cine</span><span class="logo-verse">Verse</span>
      </a>
    </nav>
  </header>

  <!-- Main Content Layout -->
  <main class="main-container">
    <div class="forgot-card">
      <!-- Card Decorative Glow Inner -->
      <div class="card-glow-border" aria-hidden="true"></div>

      <!-- Header Section -->
      <div class="card-header">
        <div class="icon-wrapper">
          <div class="icon-pulse" aria-hidden="true"></div>
          <i class="fa-solid fa-lock"></i>
        </div>
        <h1 class="card-title">Đặt lại mật khẩu</h1>
        <p class="card-subtitle">
          Tạo mật khẩu mới cho tài khoản CineVerse của bạn.
        </p>
      </div>

      <!-- Feedback / Alert Container -->
      <div id="formMessage" role="alert" aria-live="polite"></div>

      <!-- Form Section -->
      <form id="resetPasswordForm" 
        action="/auth/reset-password" 
        method="POST" 
        class="forgot-form" 
        novalidate 
      >
        <!-- Input Mật khẩu mới -->
        <input
          type="hidden"
          name="token"
          value="<%= token %>"
        >
        <div class="form-group">
          <label for="password" class="form-label">
            <i class="fa-solid fa-key"></i>
            <span>Mật khẩu mới</span>
          </label>
          <div class="input-wrapper">
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="form-input" 
              placeholder="Nhập mật khẩu mới..." 
              autocomplete="new-password" 
              required
            >
            <i class="fa-solid fa-circle-check input-success-icon" aria-hidden="true"></i>
          </div>
        </div>

        <!-- Input Nhập lại mật khẩu -->
        <div class="form-group">
          <label for="confirm_password" class="form-label">
            <i class="fa-solid fa-shield-check"></i>
            <span>Nhập lại mật khẩu</span>
          </label>
          <div class="input-wrapper">
            <input 
              type="password" 
              id="confirm_password" 
              name="confirm_password" 
              class="form-input" 
              placeholder="Nhập lại mật khẩu..." 
              autocomplete="new-password" 
              required
            >
            <i class="fa-solid fa-circle-check input-success-icon" aria-hidden="true"></i>
          </div>
          
          <!-- Hint / Yêu cầu mật khẩu -->
          <div class="input-hint">
            <i class="fa-solid fa-circle-info"></i>
            <span>Mật khẩu phải có ít nhất 8 ký tự.</span>
          </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" id="submitBtn" class="btn-submit">
          <span class="btn-content">
            <i class="fa-solid fa-rotate btn-icon"></i>
            <span class="btn-text">Đổi mật khẩu</span>
          </span>
          <span class="btn-spinner" aria-hidden="true">
            <i class="fa-solid fa-spinner fa-spin"></i>
          </span>
        </button>
      </form>

      <!-- Footer Section -->
      <div class="card-footer">
        <a href="/auth" class="back-link">
          <i class="fa-solid fa-arrow-left"></i>
          <span>Quay lại đăng nhập</span>
        </a>
      </div>
    </div>
  </main>
</body>
</html>