<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Khôi phục mật khẩu - CineVerse</title>
  
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/forgot-password.css">
</head>
<body>
  <!-- Background Decorative Light Orbs -->
  <div class="bg-decorations" aria-hidden="true">
    <div class="glow-orb orb-top-left"></div>
    <div class="glow-orb orb-top-right"></div>
    <div class="glow-orb orb-center"></div>
    <div class="glow-orb orb-bottom-right"></div>
  </div>

  <!-- Navbar Section -->
  <header class="navbar-container">
    <nav class="navbar">
      <a href="/" class="brand-logo" aria-label="CineVerse Trang chủ">
        <span class="logo-cine">Cine</span><span class="logo-verse">Verse</span>
      </a>
    </nav>
  </header>

  <!-- Main Content Layout -->
  <main class="main-container">
    <div class="forgot-card">
      <!-- Card Decorative Glow Inner -->
      <div class="card-glow-border" aria-hidden="true"></div>

      <% if (typeof step !== 'undefined' && step === 'verify') { %>
        <!-- ==================== STEP 2: FORM VERIFY OTP ==================== -->
        <!-- Header Section -->
        <div class="card-header">
          <div class="icon-wrapper">
            <div class="icon-pulse" aria-hidden="true"></div>
            <i class="fa-solid fa-key"></i>
          </div>
          <h1 class="card-title">Xác nhận mã Telegram</h1>
          <p class="card-subtitle">
            Nhập mã xác nhận 6 số đã được gửi tới Telegram của bạn.
          </p>
        </div>

        <!-- Feedback / Alert Container -->
        <div
          id="formMessage"
          class="<%= error ? 'form-message error' : (success ? 'form-message success' : '') %>"
          role="alert"
          aria-live="polite"
        >
          <% if (error) { %>
            <%= error %>
          <% } else if (success) { %>
            <%= success %>
          <% } %>
        </div>

        <!-- Form OTP Section -->
        <form id="verifyOtpForm" action="/auth/forgot-password/verify" method="POST" class="forgot-form" novalidate>
          <input type="hidden" name="username" value="<%= typeof username !== 'undefined' ? username : '' %>">

          <div class="form-group">
            <label for="otpCode" class="form-label">
              <i class="fa-solid fa-shield-cat"></i>
              <span>Mã xác nhận (6 số)</span>
            </label>
            <div class="input-wrapper">
              <input 
                type="text" 
                id="otpCode" 
                name="code" 
                class="form-input" 
                placeholder="000000" 
                maxlength="6"
                inputmode="numeric"
                pattern="[0-9]{6}"
                autocomplete="one-time-code" 
                style="letter-spacing: 0.25em; font-weight: 700; text-align: center;"
                required
              >
              <i class="fa-solid fa-circle-check input-success-icon" aria-hidden="true"></i>
            </div>
            <div class="input-hint">
              <i class="fa-solid fa-clock"></i>
              <span>Mã xác nhận có hiệu lực trong 3 lần thử</span>
            </div>
          </div>

          <button type="submit" id="submitOtpBtn" class="btn-submit">
            <span class="btn-content">
              <i class="fa-solid fa-check-double btn-icon"></i>
              <span class="btn-text">Xác nhận mã</span>
            </span>
            <span class="btn-spinner" aria-hidden="true">
              <i class="fa-solid fa-spinner fa-spin"></i>
            </span>
          </button>
        </form>

        <!-- Footer Section (OTP Step) -->
        <div
          class="card-footer"
          style="display: flex; flex-direction: column; gap: 12px; align-items: center;"
        >

          <% if (typeof remainingSeconds !== "undefined" && remainingSeconds > 0) { %>

            <!-- Đang bị khóa, chờ countdown -->
            <div
              id="otpCooldown"
              data-remaining-seconds="<%= remainingSeconds %>"
              style="font-size: 0.9rem; opacity: 0.9; text-align: center;"
            >
              <div style="margin-bottom: 6px;">
                Bạn đã nhập sai quá 3 lần.
              </div>

              <div>
                ⏳ Vui lòng chờ
                <strong id="countdown"><%= remainingSeconds %></strong>
                để yêu cầu mã mới.
              </div>
            </div>

            <!-- Nút resend, ban đầu ẩn -->
            <form
              id="resendOtpForm"
              action="/auth/forgot-password"
              method="POST"
              style="display: none;"
            >
              <input
                type="hidden"
                name="username"
                value="<%= typeof username !== 'undefined' ? username : '' %>"
              >

              <button
                type="submit"
                class="btn-submit"
                style="margin-top: 10px;"
              >
                <span class="btn-content">
                  <i class="fa-solid fa-paper-plane btn-icon"></i>
                  <span class="btn-text">Gửi lại mã mới</span>
                </span>
              </button>
            </form>

          <% } else { %>

            <!-- Không bị cooldown -->
            <% 
              const showResend =
                typeof error === "string" &&
                (
                  error.includes("hết hạn") ||
                  error.includes("hết hiệu lực")
                );
            %>

            <% if (showResend) { %>

              <form
                action="/auth/forgot-password"
                method="POST"
                style="width: 100%;"
              >
                <input
                  type="hidden"
                  name="username"
                  value="<%= typeof username !== 'undefined' ? username : '' %>"
                >

                <button type="submit" class="resend-link">
                  Gửi lại mã mới
                </button>
              </form>

            <% } %>

          <% } %>

          <a href="/auth/forgot-password" class="back-link">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Quay lại bước trước</span>
          </a>

        </div>

      <% } else { %>
        <!-- ==================== STEP 1: FORM REQUEST OTP ==================== -->
        <!-- Header Section -->
        <div class="card-header">
          <div class="icon-wrapper">
            <div class="icon-pulse" aria-hidden="true"></div>
            <i class="fa-solid fa-shield-halved"></i>
          </div>
          <h1 class="card-title">Khôi phục mật khẩu</h1>
          <p class="card-subtitle">
            Nhập Username hoặc số điện thoại đã đăng ký. Chúng tôi sẽ gửi liên kết đặt lại mật khẩu đến Telegram của bạn.
          </p>
        </div>

        <!-- Feedback / Alert Container -->
        <div id="formMessage" role="alert" aria-live="polite"></div>

        <!-- Form Section -->
        <form id="forgotPasswordForm" action="/auth/forgot-password" method="POST" class="forgot-form" novalidate>
          <div class="form-group">
            <label for="identifier" class="form-label">
              <i class="fa-solid fa-user"></i>
              <span>Username hoặc Số điện thoại</span>
            </label>
            <div class="input-wrapper">
              <input 
                type="text" 
                id="identifier" 
                name="username" 
                class="form-input" 
                placeholder="Nhập Username hoặc SĐT..." 
                autocomplete="username" 
                required
              >
              <i class="fa-solid fa-circle-check input-success-icon" aria-hidden="true"></i>
            </div>
            <div class="input-hint">
              <i class="fa-solid fa-lightbulb"></i>
              <span>Không nhớ Username? Bạn có thể sử dụng số điện thoại đã đăng ký.</span>
            </div>
          </div>

          <button type="submit" id="submitBtn" class="btn-submit">
            <span class="btn-content">
              <i class="fa-brands fa-telegram btn-icon"></i>
              <span class="btn-text">Gửi liên kết qua Telegram</span>
            </span>
            <span class="btn-spinner" aria-hidden="true">
              <i class="fa-solid fa-spinner fa-spin"></i>
            </span>
          </button>
        </form>

        <!-- Footer Section -->
        <div class="card-footer">
          <a href="/auth" class="back-link">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Quay lại đăng nhập</span>
          </a>
        </div>
      <% } %>

    </div>
  </main>

  <!-- Custom JavaScript -->
  <script src="/js/forgot-password.js"></script>
</body>
</html>